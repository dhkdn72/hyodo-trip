# 효도여행 설계 도우미 — 환경 변수
# 이 파일을 .env 로 복사한 뒤 키를 채우세요. 비워 두면 해당 단계는 예시 데이터·추정치로 동작합니다.

# 서버 포트
PORT=8787

# 공공데이터포털(data.go.kr) 일반 인증키 — '한국관광공사_국문 관광정보 서비스_GW' 활용신청 필요
# Decoding 키를 권장합니다 (Encoding 키를 넣어도 동작)
TOUR_API_KEY=

# 무장애 여행 정보(KorWithService2) — '한국관광공사_무장애 여행 정보' 도 활용신청 필요
# 같은 포털 계정이면 키가 같으므로 비워 두면 TOUR_API_KEY 를 씁니다
KORWITH_API_KEY=

# 카카오 REST API 키 — [앱] > [플랫폼 키] 에서 확인, [카카오맵] > [사용 설정] ON 필요
# 쓰는 API: 로컬(주소·키워드·카테고리 검색), 카카오맵 도보 경로, 카카오모빌리티 자동차 길찾기
KAKAO_REST_API_KEY=
# 도보 경로 옵션: ACCESSIBLE(편안한 길, 기본) | BROAD_FIRST(넓은 길 우선) | SHORTEST(최단)
KAKAO_WALK_ROUTE_MODE=ACCESSIBLE

# LLM (6 설명 붙이기, 자유 입력 해석) — 둘 중 하나. 없으면 템플릿 문장·규칙을 씁니다
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# OpenAI 호환 API 를 쓰려면 키와 모델명을 함께 넣으세요
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
# Google Gemini (AI Studio 키, 무료 등급 있음)를 쓸 때:
#   OPENAI_API_KEY=AI Studio 키
#   OPENAI_MODEL=gemini-3.5-flash-lite,gemini-3.5-flash   ← 쉼표로 여러 개: 앞 모델이 혼잡·시간 초과면 다음 모델
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   쓸 수 있는 모델 이름은 npm run dev 상태에서 http://localhost:5173/api/dev/llm-models
# 추론 모델의 생각 정도 (비우면 Gemini 는 low)
OPENAI_REASONING_EFFORT=
# LLM 한 번 호출 제한 시간(ms) — 넘으면 다음 모델로
LLM_TIMEOUT_MS=8000

# 의미 기반 추천(취향 문장 ↔ 장소 소개글) 문장 임베딩 모델 — 서버가 처음 쓸 때 Hugging Face 에서 한 번 내려받아
# server/.cache/models 에 저장합니다. 끄려면 off
EMBEDDING_MODEL=Xenova/multilingual-e5-small

# 앱(Capacitor 등)에서 서버를 부를 때 허용할 Origin (쉼표 구분, 비우면 모두 허용)
CORS_ORIGINS=

# ── 클라이언트(웹 화면)용 — VITE_ 로 시작해야 브라우저에 전달됩니다 ──
# 카카오 JavaScript 키 — 지도 표시(카카오맵 JS SDK)와 카카오톡 공유에 사용
# [앱] > [플랫폼 키] > [JavaScript 키] 의 'JavaScript SDK 도메인'에 접속 주소(http://localhost:5173 등) 등록,
# 카카오톡 공유를 쓰려면 [앱] > [제품 링크 관리] > [웹 도메인]에도 등록
VITE_KAKAO_JS_KEY=
# 앱으로 감싸 다른 주소에서 서버를 부를 때만 (예: https://api.example.com). 웹은 비워 두세요
VITE_API_BASE=
